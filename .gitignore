# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# React admin web
admin-web/node_modules
admin-web/dist
admin-web/.env

# Secrets (use .env.example templates only)
.env
**/.env
!**/.env.example
access_backend/.env.waverep_test
access_backend/.env.smoke.local
access_backend/.env.uat.local
access_backend/.env.uat.accounts.local
