# PostgreSQL (ACCESS VisionCheck)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_NAME=access

# Or single connection URL:
# DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/access

# Development: drop all tables before create (use with care)
# RECREATE_DB=true

# FastAPI — Admin Web (Chrome) + Mobile (Android / LAN)
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_HOST=10.0.22.98

ALLOWED_HOSTS=10.0.22.98,localhost,127.0.0.1

JWT_SECRET=change_this_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://10.0.22.98:3001,http://localhost:3001,http://127.0.0.1:3001,http://localhost,http://127.0.0.1
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
# Practice evaluation videos (3 min phone recordings often exceed 100 MB).
EVALUATION_MAX_UPLOAD_MB=350

# Firebase Storage — photos/videos (recommended for production)
# Download service account JSON from Firebase Console → Project settings → Service accounts
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/serviceAccountKey.json
FIREBASE_STORAGE_ENABLED=true

# Facebook Page — ACCESS (https://www.facebook.com/profile.php?id=1202339146306816)
FACEBOOK_PAGE_ID=1202339146306816
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: existing Page album for bulk publish (API cannot create albums). Auto-detects "Photos" if blank.
FACEBOOK_PAGE_ALBUM_ID=

# Meta app (optional — mobile SDK)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# AI-generated media detection: probe (PROBE-DINOv2, local checkpoint) or univfd (CLIP ViT-L/14)
AI_DETECTOR_BACKEND=probe

# Outbound email (registration received / approved / declined)
# Leave EMAIL_ENABLED=false until SMTP is configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=access@your-campus.edu.ph
EMAIL_FROM_NAME=ACCESS VisionCheck
