# PostgreSQL (ACCESS VisionCheck)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_NAME=access

# Or single connection URL:
# DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/access

# Development: drop all tables before create (use with care)
# RECREATE_DB=true

# Optional: create demo member/org accounts and sample requests on create_tables.py
# SEED_DEMO_DATA=true

# FastAPI — Admin Web (Chrome) + Mobile (Android / LAN)
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_HOST=10.0.22.98

ALLOWED_HOSTS=10.0.22.98,localhost,127.0.0.1

JWT_SECRET=change_this_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://10.0.22.98:3001,http://localhost:3001,http://127.0.0.1:3001,http://localhost,http://127.0.0.1
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
# Practice evaluation videos (3 min phone recordings often exceed 100 MB).
EVALUATION_MAX_UPLOAD_MB=350
# Practice evaluation video max length (seconds).
EVALUATION_MAX_VIDEO_SECONDS=30
# FFmpeg frame samples for practice video quality (2–8; default 4).
# EVALUATION_VIDEO_SAMPLE_FRAMES=4

# Google Gemini — member eval coaching text and admin daily summary (not AI detection).
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use a current model id (older 1.5 / 2.0 / 2.5 names may return 404).
GEMINI_MODEL=gemini-3.8-flash

# Firebase — FCM push (required for device notifications)
# Service account: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_STORAGE_BUCKET=access-visioncheck.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON=secrets/firebase-service-account.json
# Local disk uploads when false; set true only after enabling Storage in Firebase (Blaze)
# Leave false when using Supabase for media (see below). Firebase project still used for FCM push.
FIREBASE_STORAGE_ENABLED=false

# Supabase Storage — canonical store for photos / videos (backend upload via service role)
# Dashboard: Storage → bucket (e.g. access-media). Settings → API → URL + service_role key.
# Mobile/admin upload multipart to API; backend writes to Supabase (not Firebase Storage).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=access-media
SUPABASE_STORAGE_ENABLED=true
# Match or exceed EVALUATION_MAX_UPLOAD_MB for practice videos.
SUPABASE_MAX_UPLOAD_MB=350
SUPABASE_SERVICE_ROLE_KEY_FILE=secrets/supabase-service-role.key

# Facebook Page — ACCESS (https://www.facebook.com/profile.php?id=1202339146306816)
FACEBOOK_PAGE_ID=1202339146306816
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: existing Page album for bulk publish (API cannot create albums). Auto-detects "Photos" if blank.
FACEBOOK_PAGE_ALBUM_ID=

# Meta app (optional — mobile SDK)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# AI-generated media detection: probe (PROBE-DINOv2, local checkpoint) or univfd (CLIP ViT-L/14)
AI_DETECTOR_BACKEND=probe

# Email OTP (registration + password reset)
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_TOKEN_MINUTES=30
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# Outbound email (registration OTP, password reset, approved/declined)
# Leave EMAIL_ENABLED=false until SMTP is configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=access@your-campus.edu.ph
EMAIL_FROM_NAME=ACCESS VisionCheck
# Registration emails (pending / approved / declined) are no-reply only.
# Use a campus noreply mailbox or alias; replies go here and should not be read.
EMAIL_NO_REPLY=noreply@your-campus.edu.ph
# Optional: human-monitored address for non-registration mail (future use).
# EMAIL_REPLY_TO=
# EMAIL_LOGO_PATH=
