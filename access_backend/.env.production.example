# ACCESS VisionCheck — production environment template
# Copy to .env on the server and fill real values. Never commit secrets.

APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=access_app
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=access_visioncheck

API_HOST=0.0.0.0
API_PORT=3001
# Public hostname clients use (HTTPS via nginx)
API_PUBLIC_HOST=api.example.com
ALLOWED_HOSTS=api.example.com,127.0.0.1
# Explicit HTTPS admin / mobile web origins (no *)
CORS_ORIGINS=https://admin.example.com,https://app.example.com

JWT_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_LOCKOUT_ENABLED=true

# Authenticity — PROBE only (UnivFD retired)
AI_DETECTOR_BACKEND=probe
# PROBE_CHECKPOINT_PATH=/opt/access/models/DINOv2_best_model_step_34999.pth
QUALITY_ENGINE=musiq_worker
MUSIQ_WORKER_URL=https://musiq.example.com
MUSIQ_WORKER_TOKEN=REPLACE_ME

# Media
UPLOAD_DIR=uploads
SUPABASE_STORAGE_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=access-media
SUPABASE_SERVICE_ROLE_KEY_FILE=secrets/supabase_service_role.txt
FIREBASE_STORAGE_ENABLED=false

# Notifications / email / SMS — real channels required in production
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
