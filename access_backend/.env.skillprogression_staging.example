# Isolated skill progression v2 staging — copy to .env.skillprogression_staging
# Load with:  $env:ACCESS_ENV_FILE = (Resolve-Path .env.skillprogression_staging).Path
# NEVER set DB_NAME=postgres or production DB names here.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=access_skillprogression_staging

# Optional explicit URL (must match DB_NAME above):
# DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/access_skillprogression_staging

SKILL_PROGRESSION_ACTIVE_POLICY=v1

# Bind all interfaces for physical-phone LAN testing (private Wi-Fi only).
API_HOST=0.0.0.0
API_PORT=3011
API_PUBLIC_HOST=192.168.8.99
ALLOWED_HOSTS=127.0.0.1,127.0.0.1:3011,localhost,localhost:3011,192.168.8.99,192.168.8.99:3011
CORS_ORIGINS=http://127.0.0.1:3011,http://localhost:3011,http://192.168.8.99:3011

UPLOAD_DIR=uploads_staging_skillprogression
JWT_SECRET=staging_only_change_me

# Do not enable v2 until grandfather --apply completed on THIS database only.
# SKILL_PROGRESSION_ACTIVE_POLICY=v2
