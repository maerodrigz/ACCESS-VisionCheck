# ACCESS VisionCheck — UAT stack (NOT production, NOT QA waverep_test).
# Copy to .env.uat.local (gitignored) and adjust passwords locally.
#
# Start API:
#   cd access_backend
#   set ACCESS_ENV_FILE=.env.uat.local
#   python manage.py runserver --host 127.0.0.1 --port 3005 --no-reload
#
# Provision DB + accounts (first time only):
#   python scripts/seed_uat_accounts.py

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/access_uat

API_HOST=127.0.0.1
API_PORT=3005
API_PUBLIC_HOST=127.0.0.1

ALLOWED_HOSTS=127.0.0.1,127.0.0.1:3005,localhost,localhost:3005
CORS_ORIGINS=http://127.0.0.1:3005,http://localhost:3005,http://127.0.0.1,http://localhost,http://localhost:5175,http://127.0.0.1:5175

UPLOAD_DIR=uploads_uat

SUPABASE_STORAGE_ENABLED=false
FIREBASE_STORAGE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=

WAVEREP_ENABLED=false
AI_DETECTOR_BACKEND=probe

# External channels OFF for UAT unless leadership approves explicitly.
EMAIL_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

JWT_SECRET=change_me_uat_only_not_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

EVALUATION_MAX_VIDEO_SECONDS=60
