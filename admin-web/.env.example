# Default: use Vite dev proxy (see vite.config.ts) → port 3001 unless VITE_DEV_PROXY_TARGET is set.
VITE_API_BASE_URL=/api

# Isolated test API on 3003 (recommended):
#   .\scripts\dev-isolated-3003.ps1
# Or PowerShell, same session as npm run dev:
#   $env:VITE_API_BASE_URL="/api"
#   $env:VITE_DEV_PROXY_TARGET="http://127.0.0.1:3003"
#   npm run dev

# Direct URL (requires API ALLOWED_HOSTS to include Host :3003, or health checks fail):
# VITE_API_BASE_URL=http://127.0.0.1:3001/api
