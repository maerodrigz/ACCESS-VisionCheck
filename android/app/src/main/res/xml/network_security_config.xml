<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP to the dev API on any LAN IP (PC Wi-Fi address changes often). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
