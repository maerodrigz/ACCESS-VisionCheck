<?xml version="1.0" encoding="utf-8"?>
<!-- Production / release: HTTPS only. Cleartext is enabled in debug builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
