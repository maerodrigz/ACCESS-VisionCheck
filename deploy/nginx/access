# ACCESS VisionCheck — Nginx reverse proxy (production template)
#
# Install:
#   sudo cp deploy/nginx/access /etc/nginx/sites-available/access
#   sudo ln -sf /etc/nginx/sites-available/access /etc/nginx/sites-enabled/access
#   sudo nginx -t && sudo systemctl reload nginx
#
# After DNS is ready, add TLS:
#   sudo certbot --nginx -d api.example.com -d admin.example.com
#
# FastAPI must listen on 127.0.0.1:3001 with APP_ENV=production (reload off).
# Practice media is NOT proxied as a public /uploads tree; use JWT stream routes.

upstream access_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

# API host
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    client_max_body_size 400M;

    location /api/ {
        proxy_pass http://access_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Branding / profile avatars only (mounted by FastAPI in production).
    location /uploads/branding/ {
        proxy_pass http://access_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /uploads/profiles/ {
        proxy_pass http://access_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}

# React admin SPA (serve admin-web/dist)
server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;

    root /var/www/access-admin;
    index index.html;

    client_max_body_size 400M;

    location /api/ {
        proxy_pass http://access_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
