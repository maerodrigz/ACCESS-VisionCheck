# ACCESS VisionCheck MUSIQ worker (Linux / Docker / Fly)
# Copy to .env locally only. Never commit .env or real tokens.

WORKER_HOST=0.0.0.0
# Cloud platforms inject PORT; entrypoint uses PORT then WORKER_PORT.
PORT=8080
WORKER_PORT=8080

# Required for /v1/evaluate. Generate a long random secret (do not commit it).
MUSIQ_WORKER_TOKEN=change-me-to-a-long-random-secret

# Dev-only: allow empty token (never in cloud).
ALLOW_INSECURE_EMPTY_TOKEN=false

MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=83886080
REQUEST_TIMEOUT_SEC=120
VIDEO_SAMPLE_FRAMES=4

TFHUB_CACHE_DIR=/models/tfhub
MUSIQ_HANDLE=https://tfhub.dev/google/musiq/paq2piq/1
CUDA_VISIBLE_DEVICES=-1
PRELOAD_MUSIQ=true
