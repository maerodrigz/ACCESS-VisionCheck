# Copy to .env and fill with generate_secrets.py output. Never commit .env.

PORT=8090
DATABASE_PATH=./data/ratings.sqlite3
IMAGES_DIR=../workspace/phase6a_human_validation/rater_pack/images
PUBLIC_BASE_URL=http://127.0.0.1:8090

# Required in production (R1:token,R2:token,R3:token)
EVALUATOR_INVITES=
FACILITATOR_TOKEN=

# Local-only convenience; must stay false in production
ALLOW_BOOTSTRAP_WITHOUT_SECRETS=false
CORS_ORIGINS=*
