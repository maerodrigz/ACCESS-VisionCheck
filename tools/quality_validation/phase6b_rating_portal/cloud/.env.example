# Cloudflare Worker + Supabase (research project ONLY — not production ACCESS).
# Copy to cloud/.env.local for notes; real secrets go into `wrangler secret put`.

# Public
PAGES_BASE_URL=https://YOUR-PROJECT.pages.dev
PHASE6B_API_BASE=https://access-phase6b-api.YOUR_SUBDOMAIN.workers.dev

# Supabase research project (base URL only — no /rest/v1/)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred (new): Secret API key
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME_NEVER_IN_PAGES
# Legacy (JWT) — migrate away; creating sb_secret_ does NOT revoke this
# SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_ME
SUPABASE_STORAGE_BUCKET=phase6b-indval
SUPABASE_ANON_KEY=OPTIONAL_NOT_USED_BY_WORKER

# Portal secrets
FACILITATOR_TOKEN=REPLACE_ME_LONG_RANDOM
# Invite plaintext (password manager only). Store SHA-256 hashes in evaluators table.
EVALUATOR_INVITE_R1=
EVALUATOR_INVITE_R2=
EVALUATOR_INVITE_R3=
